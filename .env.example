# Neon PostgreSQL connection string used by the Nitro API routes.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Public storefront origin, used for canonical links and Open Graph tags.
NUXT_PUBLIC_SITE_URL=https://aaroh.in

# Firebase Web app configuration (public values; restrict the API key in Google Cloud).
NUXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAC4rn9alNVXDFkbNGCM4vgBD_-aEuMae8
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aaroh-d9cdb.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=aaroh-d9cdb
NUXT_PUBLIC_FIREBASE_APP_ID=1:808175931485:web:b56a87cb212b1d8ecbbdb4
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=808175931485

# Server-only Firebase Admin service-account JSON for generating email-verification links.
# Firebase ID-token checks use the public project ID above and do not require this credential.
NUXT_FIREBASE_SERVICE_ACCOUNT_JSON=
NUXT_FIREBASE_AUTH_BASE_URL=http://localhost:3000
# Email address of the verified Firebase account allowed to save dashboard settings and banners.
NUXT_STUDIO_ADMIN_EMAIL=

# Server-only SMTP account used for Firebase email verification and welcome mail.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=
